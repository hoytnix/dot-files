# Path to your oh-my-zsh installation
export ZSH="$HOME/.oh-my-zsh"

# Theme Configuration
ZSH_THEME="seahorse"

# SSH Agent Plugin Configuration
zstyle :omz:plugins:ssh-agent lifetime 2h
zstyle :omz:plugins:ssh-agent quiet yes
zstyle :omz:plugins:ssh-agent agent-forwarding yes

# Oh My Zsh Plugins
plugins=(
    git
    ssh-agent
)

source $ZSH/oh-my-zsh.sh

# --- PATH Adjustments ---
export PATH="$HOME/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/bin:$PATH"
export EDITOR='vim'
export LANG="en_US.UTF-8"

# --- Convenience Aliases ---
alias s="sudo"

# Pacman shortcuts (Arch Linux)
alias pS="s pacman -S"
alias pSs="s pacman -Ss"
alias pSyu="s pacman -Syu"

# Apt shortcuts (Debian/Ubuntu)
alias apti="s apt install -y"
alias aptu="s apt update && s apt upgrade -y"

# Server / System Inspection
alias ports="s netstat -tulanp"
alias myip="curl -s ifconfig.me"
alias nginx-reload="s nginx -t && s systemctl reload nginx"
alias f2b-status="s fail2ban-client status"
alias ufw-status="s ufw status verbose"

# --- Python Virtualenv Helpers ---
function venv() {
    if [ -z "$1" ]; then
        echo "Usage: venv <env_name>"
        return 1
    fi
    source ~/.venvs/$1/bin/activate
}

function venvN() {
    if [ -z "$1" ]; then
        echo "Usage: venvN <env_name>"
        return 1
    fi
    python3 -m venv ~/.venvs/$1
    venv $1
    python -m pip install --upgrade pip
}

# --- Keybindings ---
bindkey -s '[11~' 'urxvt &\n'
bindkey -s '[12~' 'thunar . &\n'

# --- NVM Configuration ---
export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"

# --- PNPM Configuration ---
export PNPM_HOME="$HOME/.local/share/pnpm"
case ":$PATH:" in
  *":$PNPM_HOME:"*) ;;
  *) export PATH="$PNPM_HOME:$PATH" ;;
esac

# Dynamic Prompt
PROMPT='%n@%m %~ %# '
